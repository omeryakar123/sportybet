// SportyBet — veri modeli
// Cüzdan mantığı: her oyuncunun 2 cüzdanı var
//   MAIN  = Ana para (yatırımlar buraya, çekilebilir)
//   BONUS = Bonus cüzdanı (çevrim tamamlanınca bakiye MAIN'e aktarılır)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WalletType {
  MAIN
  BONUS
}

enum TxType {
  DEPOSIT
  WITHDRAWAL
  BET_STAKE
  BET_WIN
  BET_REFUND
  BONUS_GRANT
  BONUS_CONVERT // bonus cüzdanından ana paraya aktarım
  BONUS_EXPIRE
  BONUS_CANCEL
  ADJUSTMENT // admin manuel düzeltme
  WITHDRAWAL_REFUND // reddedilen/iptal edilen çekim iadesi
  PREDICTION_BUY
  PREDICTION_SELL
  PREDICTION_WIN
  PREDICTION_REFUND
  CORRECTION_UP
  CORRECTION_DOWN
}

enum PaymentType {
  DEPOSIT
  WITHDRAWAL
}

enum PaymentState {
  NEW
  PENDING   // onaylandı, ödeme bekliyor
  PAID
  REJECTED
  CANCELLED // oyuncu iptal etti
}

enum BetState {
  PENDING
  ACTIVE
  WON
  LOST
  RETURNED
  CASHED_OUT
  CANCELLED
}

enum BetType {
  SINGLE
  MULTIPLE
  SYSTEM
}

enum BonusType {
  DEPOSIT
  MANUAL
  FREEBET
  FREESPIN
  CASINO_FREEBET
  WAGERING // kayıp bonusu vb. çevrimli bonus
}

enum PlayerBonusState {
  ACTIVE
  COMPLETED // çevrim tamamlandı -> ana paraya aktarıldı
  EXPIRED
  CANCELED
  LOST // bonus bakiyesi sıfırlandı
}

enum AdminRole {
  SUPERADMIN
  ADMIN
  FINANCE
  RISK
  SUPPORT
  CMS
}

// Bir kurulumda birden çok marka/site. Her oyuncu, bonus, promo, ödeme yöntemi ve CMS içeriği bir siteye bağlıdır.
// Tahmin piyasaları GLOBALDİR (tüm siteler aynı piyasaları görür); pozisyonlar oyuncu üzerinden siteye bağlanır.
model Site {
  id             Int      @id @default(autoincrement())
  code           String   @unique // kısa ad: sportybet, cryptobet...
  name           String
  domain         String?  @unique // oyuncu sitesinin domaini (Origin ile eşleşir)
  isActive       Boolean  @default(true)
  // Betco sportsbook kimlikleri (boşsa env'deki varsayılan kullanılır)
  sbApiUrl       String?
  sbApiKey       String?
  sbApiSecret    String?
  sbWalletSecret String?
  note           String?
  createdAt      DateTime @default(now())
  players        Player[]
}

model Admin {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  fullName     String?
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  auditLogs    AuditLog[]
}

model Player {
  id             Int       @id @default(autoincrement())
  siteId         Int       @default(1)
  username       String
  email          String?
  phone          String?
  passwordHash   String
  firstName      String?
  lastName       String?
  birthDate      DateTime?
  currency       String    @default("TRY")
  language       String    @default("tr")
  status         String    @default("OPEN") // OPEN, BLOCKED, CLOSED, SELF_EXCLUDED
  category       String    @default("LOW_RISK")
  isVerified     Boolean   @default(false)
  isSportBlocked Boolean   @default(false)
  isCasinoBlocked Boolean  @default(false)
  excludedFromBonuses Boolean @default(false)
  loyaltyLevel   String?
  loyaltyPoints  Decimal   @default(0) @db.Decimal(18, 2)
  btag           String?
  promoCode      String?
  regSource      String    @default("Web")
  isTest         Boolean   @default(false)
  activeWallet   WalletType @default(MAIN) // oyuncunun oynadığı cüzdan (sportsbook + tahmin sadece bunu görür)
  city           String?
  address        String?
  gender         String?
  affiliateId    String?
  wrongLoginAttempts Int   @default(0)
  lastLoginAt    DateTime?
  lastLoginIp    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  wallets       Wallet[]
  transactions  Transaction[]
  bets          Bet[]
  bonuses       PlayerBonus[]
  notes         PlayerNote[]
  logins        LoginLog[]
  payments      PaymentRequest[]
  predictionPositions PredictionPosition[]
  predictionSaves PredictionSave[]
  bonusRequests BonusRequest[]
  promoRedemptions PromoRedemption[]
}

model Wallet {
  id        Int        @id @default(autoincrement())
  playerId  Int
  type      WalletType
  currency  String     @default("TRY")
  balance   Decimal    @default(0) @db.Decimal(18, 2)
  updatedAt DateTime   @updatedAt
  player    Player     @relation(fields: [playerId], references: [id])
  transactions Transaction[]

  @@unique([playerId, type, currency])
}

model Transaction {
  id            BigInt   @id @default(autoincrement())
  playerId      Int
  walletId      Int
  type          TxType
  amount        Decimal  @db.Decimal(18, 2) // + giriş, - çıkış
  balanceAfter  Decimal  @db.Decimal(18, 2)
  paymentSystem String?
  reference     String?  // betId, bonusId, psp tx id
  note          String?
  adminId       Int?
  createdAt     DateTime @default(now())
  player        Player   @relation(fields: [playerId], references: [id])
  wallet        Wallet   @relation(fields: [walletId], references: [id])

  @@index([playerId, createdAt])
}

model Bet {
  id           BigInt   @id @default(autoincrement())
  providerBetId String? @unique // Betco bet_id
  couponId     String?  // Betco coupon_id (oyuncunun gördüğü numara)
  playerId     Int
  type         BetType
  stake        Decimal  @db.Decimal(18, 2)
  stakeFromMain  Decimal @default(0) @db.Decimal(18, 2)
  stakeFromBonus Decimal @default(0) @db.Decimal(18, 2)
  totalOdds    Decimal  @db.Decimal(12, 3)
  potentialWin Decimal  @db.Decimal(18, 2)
  winAmount    Decimal  @default(0) @db.Decimal(18, 2)
  state        BetState @default(PENDING)
  isLive       Boolean  @default(false)
  playerBonusId Int?
  source       String   @default("Web")
  ip           String?
  createdAt    DateTime @default(now())
  settledAt    DateTime?
  player       Player   @relation(fields: [playerId], references: [id])
  selections   BetSelection[]

  @@index([playerId, createdAt])
  @@index([state])
}

model BetSelection {
  id            BigInt   @id @default(autoincrement())
  betId         BigInt
  providerEventId String
  sport         String
  region        String?
  competition   String?
  matchName     String
  matchStart    DateTime
  market        String
  selection     String
  odds          Decimal  @db.Decimal(12, 3)
  state         BetState @default(PENDING)
  isLive        Boolean  @default(false)
  info          String?  // skor / dakika bilgisi
  bet           Bet      @relation(fields: [betId], references: [id])
}

// ---------- Betco seamless wallet ----------
// Platformdan gelen her /debit /credit /rollback çağrısı. transactionId ile idempotent.
model WalletRequest {
  id            Int      @id @default(autoincrement())
  transactionId String   @unique
  kind          String   // debit | credit | rollback
  playerId      Int
  amount        Decimal  @db.Decimal(18, 2)
  currency      String
  providerBetId String?
  couponId      String?
  reason        String?
  fromMain      Decimal  @default(0) @db.Decimal(18, 2) // debit: ana cüzdandan düşülen / credit: ana cüzdana yatan
  fromBonus     Decimal  @default(0) @db.Decimal(18, 2)
  status        String   // SUCCESS | REJECTED
  refunded      Boolean  @default(false) // debit rollback ile iade edildi mi
  httpStatus    Int      @default(200)
  response      Json
  createdAt     DateTime @default(now())

  @@index([playerId, createdAt])
  @@index([providerBetId])
}

// Rollback'i debit'ten önce gelen işlemler: bu ID ile debit gelirse 409 TRANSACTION_CANCELLED
model CancelledTransaction {
  transactionId String   @id
  createdAt     DateTime @default(now())
}

// Webhook tekilleştirme + log (X-Webhook-Id)
model WebhookEvent {
  webhookId String   @id
  event     String
  payload   Json
  error     String?
  createdAt DateTime @default(now())
}

// Bonus tanımı (Backoffice > Bonuses > Add New Bonus)
model Bonus {
  id              Int       @id @default(autoincrement())
  siteId          Int       @default(1)
  name            String
  type            BonusType
  product         String    @default("SPORT") // SPORT, CASINO
  description     String?
  note            String?
  isActive        Boolean   @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  expirationType  String    @default("FROM_PAYOUT_DATE")
  expirationDays  Int       @default(7)
  allowWithdrawal Boolean   @default(false)
  availableOnRequest Boolean @default(false)
  // Çevrim kuralları
  wageringMultiplier Decimal @default(1) @db.Decimal(8, 2) // bonus x N kadar bahis
  // Para birimi bazlı ayarlar
  minAmount       Decimal?  @db.Decimal(18, 2)
  maxAmount       Decimal?  @db.Decimal(18, 2)
  maxPayout       Decimal?  @db.Decimal(18, 2)
  maxPayoutPct    Decimal?  @db.Decimal(8, 2)
  percent         Decimal?  @db.Decimal(8, 2) // yatırım bonusu % oranı
  // Spor kuralları (Sport sekmesi)
  rules           Json?     // {sports:[], competitions:[], matches:[], markets:[], regions:[], betType, eventType, minSelections, minSelectionOdds, minTotalOdds}
  createdAt       DateTime  @default(now())
  playerBonuses   PlayerBonus[]
  promoCodes      PromoCode[]
  bonusRequests   BonusRequest[]
}

model PlayerBonus {
  id             Int       @id @default(autoincrement())
  playerId       Int
  bonusId        Int
  state          PlayerBonusState @default(ACTIVE)
  amount         Decimal   @db.Decimal(18, 2)
  wagerRequired  Decimal   @db.Decimal(18, 2)
  wagerDone      Decimal   @default(0) @db.Decimal(18, 2)
  convertedAmount Decimal  @default(0) @db.Decimal(18, 2)
  grantedByAdminId Int?
  expiresAt      DateTime?
  resultAt       DateTime?
  createdAt      DateTime  @default(now())
  player         Player    @relation(fields: [playerId], references: [id])
  bonus          Bonus     @relation(fields: [bonusId], references: [id])

  @@index([playerId, state])
}

model PromoCode {
  id          Int      @id @default(autoincrement())
  siteId      Int      @default(1)
  code        String
  bonusId     Int
  amount      Decimal  @db.Decimal(18, 2)
  currency    String   @default("TRY")
  maxCount    Int
  usedCount   Int      @default(0)
  isActive    Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  conditions  Json?    // fromRegistration, fromDeposit, emailVerified, phoneVerified, minDepositCount...
  description String?
  createdAt   DateTime @default(now())
  bonus       Bonus    @relation(fields: [bonusId], references: [id])
  redemptions PromoRedemption[]

  @@unique([siteId, code])
}

model PromoRedemption {
  id          Int       @id @default(autoincrement())
  promoCodeId Int
  playerId    Int
  playerBonusId Int?
  createdAt   DateTime  @default(now())
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  player      Player    @relation(fields: [playerId], references: [id])

  @@unique([promoCodeId, playerId])
}

// Oyuncunun siteden talep ettiği bonus (Bonus "Talep ile alınabilir" ise) — admin onaylar
model BonusRequest {
  id          Int      @id @default(autoincrement())
  playerId    Int
  bonusId     Int
  state       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  amount      Decimal? @db.Decimal(18, 2)
  note        String?
  playerBonusId Int?
  processedByAdminId Int?
  processedAt DateTime?
  createdAt   DateTime @default(now())
  player      Player   @relation(fields: [playerId], references: [id])
  bonus       Bonus    @relation(fields: [bonusId], references: [id])

  @@index([state])
}

// ---------- Ödemeler ----------
model PaymentSystem {
  id          Int      @id @default(autoincrement())
  siteId      Int      @default(1)
  name        String
  displayName String
  kind        String   @default("BOTH") // DEPOSIT, WITHDRAWAL, BOTH
  logoUrl     String?
  minAmount   Decimal  @default(0) @db.Decimal(18, 2)
  maxAmount   Decimal? @db.Decimal(18, 2)
  fields      Json?    // çekimde istenecek alanlar: [{key:"iban",label:"IBAN"}]
  instructions String?
  config      Json?    // kripto: { depositAddress, network, requireTxid } vb.
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([siteId, name])
}

model PaymentRequest {
  id            BigInt       @id @default(autoincrement())
  playerId      Int
  type          PaymentType
  amount        Decimal      @db.Decimal(18, 2)
  currency      String       @default("TRY")
  state         PaymentState @default(NEW)
  paymentSystem String
  info          Json?        // IBAN, cüzdan adresi, ad soyad...
  notes         String?
  bonusId       Int?         // yatırımla seçilen yatırım bonusu
  rejectReason  String?
  allowAdminId  Int?
  rejectAdminId Int?
  paidAdminId   Int?
  externalId    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  processedAt   DateTime?
  player        Player       @relation(fields: [playerId], references: [id])

  @@index([type, state, createdAt])
  @@index([playerId])
}

model PlayerNote {
  id        Int      @id @default(autoincrement())
  playerId  Int
  adminId   Int
  text      String
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id])
}

model LoginLog {
  id        Int      @id @default(autoincrement())
  playerId  Int
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  adminId   Int
  action    String
  target    String?
  payload   Json?
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id])
}

// ---------- CMS (sitedeki her görselin panelde karşılığı) ----------
model CmsBanner {
  id         Int      @id @default(autoincrement())
  siteId     Int      @default(1)
  group      String   // ör. homepage-main-left
  title      String
  imageUrl   String
  linkUrl    String?
  platform   String   @default("web") // web, mobile
  language   String   @default("tr")
  isPublished Boolean @default(true)
  sortOrder  Int      @default(0)
  startsAt   DateTime?
  endsAt     DateTime?
  updatedAt  DateTime @updatedAt
}

model CmsPromotion {
  id         Int      @id @default(autoincrement())
  siteId     Int      @default(1)
  title      String
  slug       String
  category   String   @default("TUMU")
  imageUrl   String?
  contentHtml String
  platform   String   @default("web,mobile")
  showFor    String   @default("ALL") // ALL, GUEST, LOGGED_IN
  language   String   @default("tr")
  isPublished Boolean @default(true)
  sortOrder  Int      @default(0)
  startsAt   DateTime?
  endsAt     DateTime?
  updatedAt  DateTime @updatedAt

  @@unique([siteId, slug])
}

model CmsPage {
  id         Int      @id @default(autoincrement())
  siteId     Int      @default(1)
  slug       String
  title      String
  contentHtml String
  isPublished Boolean @default(true)
  updatedAt  DateTime @updatedAt

  @@unique([siteId, slug])
}

model CmsSetting {
  siteId Int    @default(1)
  key    String // web_css, mobile_css, site_general, menus, seo... (prediction_* anahtarları globaldir, siteId=1)
  value  Json

  @@id([siteId, key])
}

// ---------- Tahmin piyasaları ----------
// Fiyat = 1 TL ödeyen bir payın fiyatı (0–1). Olasılık = fiyat × 100.
// NO_IMPACT: fiyatı admin belirler (sabit). AFFECTS_ODDS: FPMM — rezervlerden hesaplanır, alım/satımla değişir.
model PredictionCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  markets     PredictionMarketCategory[]
}

model PredictionMarket {
  id             String   @id @default(uuid())
  slug           String   @unique
  question       String
  structure      String   @default("STANDALONE") // STANDALONE, GROUP_PARENT, GROUP_CHILD
  type           String   @default("PREDICTION")
  oddsImpactMode String   @default("NO_IMPACT")  // NO_IMPACT, AFFECTS_ODDS
  parentMarketId String?
  externalMatchId String?
  externalId     String?  @unique // dış sağlayıcıdan senkron edildiyse
  source         String   @default("local")      // local, feed
  metadata       Json?    // lockReason, lockedAt, lockedBy ...
  isHomepage     Boolean  @default(false)
  sortOrder      Int      @default(0)
  buyEnabled     Boolean  @default(true)
  sellEnabled    Boolean  @default(true)
  status         String   @default("draft")       // draft, active, locked, closed, resolved, cancelled
  image          String?
  rules          String?
  deadline       DateTime?
  minStake       Decimal  @default(10) @db.Decimal(18, 2)
  maxStake       Decimal  @default(5000) @db.Decimal(18, 2)
  feePct         Decimal  @default(0) @db.Decimal(6, 3)  // AFFECTS_ODDS alım komisyonu
  liquidity      Decimal  @default(10000) @db.Decimal(18, 2) // AFFECTS_ODDS başlangıç likiditesi
  totalVolume    Decimal  @default(0) @db.Decimal(18, 2)
  resolvedOutcomeId String?
  resolvedAt     DateTime?
  resolvedByAdminId Int?
  activatedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  outcomes       PredictionOutcome[]
  categories     PredictionMarketCategory[]
  positions      PredictionPosition[]
  saves          PredictionSave[]

  @@index([status, deadline])
  @@index([parentMarketId])
}

model PredictionMarketCategory {
  marketId   String
  categoryId String
  market     PredictionMarket   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  category   PredictionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([marketId, categoryId])
}

model PredictionOutcome {
  id          String   @id @default(uuid())
  marketId    String
  name        String
  color       String?
  image       String?
  price       Decimal  @db.Decimal(10, 4)  // NO_IMPACT'te admin fiyatı; AFFECTS_ODDS'ta hesaplanıp yazılır
  reserve     Decimal  @default(0) @db.Decimal(30, 10) // AFFECTS_ODDS havuzu
  buyEnabled  Boolean  @default(true)
  sellEnabled Boolean  @default(true)
  sortOrder   Int      @default(0)
  market      PredictionMarket @relation(fields: [marketId], references: [id], onDelete: Cascade)
  positions   PredictionPosition[]
}

model PredictionPosition {
  id         BigInt   @id @default(autoincrement())
  playerId   Int
  marketId   String
  outcomeId  String
  wallet     WalletType
  stake      Decimal  @db.Decimal(18, 2)
  shares     Decimal  @db.Decimal(24, 6)
  price      Decimal  @db.Decimal(10, 4) // ortalama alış fiyatı
  status     String   @default("OPEN") // OPEN, SOLD, WON, LOST, REFUNDED
  payout     Decimal  @default(0) @db.Decimal(18, 2)
  playerBonusId Int?
  createdAt  DateTime @default(now())
  closedAt   DateTime?
  player     Player   @relation(fields: [playerId], references: [id])
  market     PredictionMarket @relation(fields: [marketId], references: [id])
  outcome    PredictionOutcome @relation(fields: [outcomeId], references: [id])

  @@index([marketId, status])
  @@index([playerId, createdAt])
}

model PredictionSave {
  playerId  Int
  marketId  String
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id])
  market    PredictionMarket @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@id([playerId, marketId])
}
